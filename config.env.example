# AI 求职数字分身 - 密钥配置模板
# ------------------------------------------------------------
# 用法：把下面每一项都填上你自己的值，然后把这个文件另存为
#       config.env（和 server.py 放在同一个目录）。
# 程序启动时会自动读取它，不用再手工设置环境变量。
#
# 注意：config.env 已经被 .gitignore 排除，不会被上传到 GitHub。
#       也请不要把它发给别人、不要贴到聊天窗口里。
# ------------------------------------------------------------

# 1) 豆包方舟聊天 API Key（控制台 -> API Key 管理）
DOUBAO_API_KEY=

# 2) 聊天模型 ID（一般不用改）
DOUBAO_MODEL=doubao-seed-1-6-251015

# 3) 豆包语音合成 API Key（语音技术控制台）
TTS_API_KEY=

# 4) 声音复刻的 Speaker ID（S_ 开头，就是"你自己的声音"）
TTS_SPEAKER_ID=

# 5) 声音复刻资源 ID（一般不用改）
TTS_RESOURCE_ID=seed-icl-2.0

# 6) 可选：访问密码。填了之后，聊天和语音接口必须带这个密码才能调用，
#    可以防止链接被转发后被人刷额度。不填就是公开可访问。
# ACCESS_PASSWORD=
